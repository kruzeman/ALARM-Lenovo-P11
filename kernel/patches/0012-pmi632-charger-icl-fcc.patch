diff --git a/drivers/power/supply/qcom_pmi632_charger.c b/drivers/power/supply/qcom_pmi632_charger.c
index 9a0923d8f..3c49a2330 100644
--- a/drivers/power/supply/qcom_pmi632_charger.c
+++ b/drivers/power/supply/qcom_pmi632_charger.c
@@ -48,6 +48,15 @@
 #define USBIN_INT_RT_STS		0x310
 #define  USBIN_PLUGIN_RT_STS		BIT(4)
 #define USBIN_ICL_CFG			0x370
+/* HVDCP (Quick Charge 2/3): auth-алгоритм + разрешение, и автономный режим,
+ * в котором чип сам ведёт адаптер по ступеням напряжения. */
+#define USBIN_OPTIONS_1_CFG		0x362
+#define  HVDCP_AUTH_ALG_EN		0x40
+#define  HVDCP_AUTONOMOUS_EN		0x20
+#define  HVDCP_EN			0x04
+#define USBIN_ADAPTER_ALLOW_CFG		0x360
+#define  USBIN_ADAPTER_ALLOW_MASK	0x0f
+#define  USBIN_ADAPTER_ALLOW_UP_TO_12V	0x07
 
 /* PMI632 ranges (smb5_pmi632_params) */
 #define PMI632_CURRENT_STEP_UA		50000
@@ -75,6 +84,7 @@ struct pmi632_chg {
 	struct delayed_work poll_work;
 	unsigned int last_online;
 	unsigned int last_state;
+	u16 dbg_reg;
 };
 
 static int pmi632_read(struct pmi632_chg *chip, u16 reg, unsigned int *val)
@@ -82,6 +92,17 @@ static int pmi632_read(struct pmi632_chg *chip, u16 reg, unsigned int *val)
 	return regmap_read(chip->regmap, chip->base + reg, val);
 }
 
+static int pmi632_write(struct pmi632_chg *chip, u16 reg, unsigned int val)
+{
+	return regmap_write(chip->regmap, chip->base + reg, val);
+}
+
+static int pmi632_masked_write(struct pmi632_chg *chip, u16 reg,
+			       unsigned int mask, unsigned int val)
+{
+	return regmap_update_bits(chip->regmap, chip->base + reg, mask, val);
+}
+
 static int pmi632_online(struct pmi632_chg *chip, int *online)
 {
 	unsigned int rt;
@@ -217,6 +238,39 @@ static int pmi632_get_step(struct pmi632_chg *chip, u16 reg, int *val)
 	return 0;
 }
 
+static int pmi632_set_step(struct pmi632_chg *chip, u16 reg, int ua)
+{
+	int step, ret;
+
+	if (ua < 0)
+		return -EINVAL;
+
+	step = ua / PMI632_CURRENT_STEP_UA;
+	if (step > 255)
+		step = 255;
+
+	ret = pmi632_write(chip, reg, step);
+	{
+		unsigned int a = 0, b = 0, p = 0, m = 0;
+		pmi632_read(chip, reg, &a);
+		pmi632_read(chip, DCDC_ICL_STATUS, &b);
+		pmi632_read(chip, DCDC_POWER_PATH_STATUS, &p);
+		pmi632_read(chip, DCDC_ICL_MAX_STATUS, &m);
+		{
+			unsigned int irt = 0, st1 = 0, st7 = 0;
+			pmi632_read(chip, USBIN_INT_RT_STS, &irt);
+			pmi632_read(chip, CHGR_STATUS_1, &st1);
+			pmi632_read(chip, CHGR_STATUS_7, &st7);
+			dev_info(chip->dev, "usbin_rt=%#x chgr1=%#x chgr7=%#x\n", irt, st1, st7);
+		}
+		dev_info(chip->dev,
+			 "set %#x: want %d uA -> step %d, readback %u, effective %u, path %#x%s, icl_max %u\n",
+			 reg, ua, step, a, b, p,
+			 (p & POWER_PATH_USBIN_SUSPEND) ? " (USBIN SUSPEND)" : "", m);
+	}
+	return ret;
+}
+
 static int pmi632_get_property(struct power_supply *psy,
 			       enum power_supply_property psp,
 			       union power_supply_propval *val)
@@ -252,6 +306,82 @@ static int pmi632_get_property(struct power_supply *psy,
 	}
 }
 
+static int pmi632_set_property(struct power_supply *psy,
+			       enum power_supply_property psp,
+			       const union power_supply_propval *val)
+{
+	struct pmi632_chg *chip = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		return pmi632_set_step(chip, USBIN_ICL_CFG, val->intval);
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		return pmi632_set_step(chip, CHGR_FCC_CFG, val->intval);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int pmi632_property_is_writeable(struct power_supply *psy,
+				       enum power_supply_property psp)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+
+static ssize_t reg_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct power_supply *psy = dev_get_drvdata(dev);
+	struct pmi632_chg *chip = power_supply_get_drvdata(psy);
+	unsigned int val = 0;
+	int ret;
+
+	ret = pmi632_read(chip, chip->dbg_reg, &val);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "reg %#x = %#x\n", chip->base + chip->dbg_reg, val);
+}
+
+static ssize_t reg_store(struct device *dev, struct device_attribute *a,
+			 const char *buf, size_t count)
+{
+	struct power_supply *psy = dev_get_drvdata(dev);
+	struct pmi632_chg *chip = power_supply_get_drvdata(psy);
+	unsigned int reg = 0, val = 0, mask = 0xff;
+	int parsed;
+
+	parsed = sscanf(buf, "%x %x %x", &reg, &val, &mask);
+	if (parsed < 1)
+		return -EINVAL;
+
+	/* Одно число — только выбрать регистр для чтения. */
+	if (parsed == 1) {
+		chip->dbg_reg = reg;
+		return count;
+	}
+
+	chip->dbg_reg = reg;
+	/* chip->base уже учтён в pmi632_masked_write/read, поэтому reg
+	 * трактуется как смещение внутри блока зарядника (0x000..0x7ff). */
+	if (parsed == 2 && mask == 0xff) {
+		pmi632_write(chip, reg, val);
+	} else {
+		pmi632_masked_write(chip, reg, mask, val);
+	}
+
+	dev_info(chip->dev, "reg %#x <- %#x (mask %#x)\n", reg, val, mask);
+	return count;
+}
+
+static DEVICE_ATTR_RW(reg);
+
 static const enum power_supply_property pmi632_props[] = {
 	POWER_SUPPLY_PROP_ONLINE,
 	POWER_SUPPLY_PROP_STATUS,
@@ -273,6 +403,8 @@ static const struct power_supply_desc pmi632_psy_desc = {
 	.properties = pmi632_props,
 	.num_properties = ARRAY_SIZE(pmi632_props),
 	.get_property = pmi632_get_property,
+	.set_property = pmi632_set_property,
+	.property_is_writeable = pmi632_property_is_writeable,
 };
 
 /* No interrupts yet: poll and notify userspace when plug or charge state change */
@@ -287,6 +419,30 @@ static void pmi632_poll(struct work_struct *work)
 	rt &= USBIN_PLUGIN_RT_STS;
 	stat &= CHGR_STATUS_MASK;
 
+	/* Открываем вход по типу источника: DCP/CDP — 3 А, SDP (порт ПК) —
+	 * 500 мА. Тип определяется не сразу после подключения, поэтому
+	 * следим за его изменением, а не только за фактом втыкания. */
+	if (rt) {
+		int type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+		unsigned int icl = 0;
+		int want;
+
+		pmi632_get_usb_type(chip, &type);
+		/* 500 мА только для порта компьютера (SDP), всем остальным
+		 * даём 3 А — AICL снизит ток, если адаптер слабый. Тип может
+		 * определиться позже, поэтому сверяем каждый опрос. */
+		/* Порт компьютера (SDP) — 500 мА по спецификации USB, всё
+		 * остальное (DCP/CDP и неопределённый источник) — 3 А; AICL
+		 * снизит ток сам, если адаптер слабый или кабель тонкий. */
+		want = (type == POWER_SUPPLY_USB_TYPE_SDP) ? 500000 : 3000000;
+		pmi632_read(chip, USBIN_ICL_CFG, &icl);
+		if (icl * PMI632_CURRENT_STEP_UA != want) {
+			dev_info(chip->dev, "тип %d: ICL %u -> %d uA\n",
+				 type, icl * PMI632_CURRENT_STEP_UA, want);
+			pmi632_set_step(chip, USBIN_ICL_CFG, want);
+		}
+	}
+
 	if (rt != chip->last_online || stat != chip->last_state) {
 		chip->last_online = rt;
 		chip->last_state = stat;
@@ -339,7 +495,18 @@ static int pmi632_probe(struct platform_device *pdev)
 
 	cfg.drv_data = chip;
 	cfg.fwnode = dev_fwnode(dev);
+	/* Quick Charge: этот планшет поддерживает QC 3.0 (PMI632 умеет HVDCP).
+	 * Без этих битов вход остаётся зажатым на малом токе. */
+	pmi632_masked_write(chip, USBIN_OPTIONS_1_CFG,
+			    HVDCP_AUTH_ALG_EN | HVDCP_AUTONOMOUS_EN | HVDCP_EN,
+			    HVDCP_AUTH_ALG_EN | HVDCP_AUTONOMOUS_EN | HVDCP_EN);
+	pmi632_masked_write(chip, USBIN_ADAPTER_ALLOW_CFG,
+			    USBIN_ADAPTER_ALLOW_MASK,
+			    USBIN_ADAPTER_ALLOW_UP_TO_12V);
+
 	chip->psy = devm_power_supply_register(dev, &pmi632_psy_desc, &cfg);
+	if (!IS_ERR(chip->psy))
+		device_create_file(&chip->psy->dev, &dev_attr_reg);
 	if (IS_ERR(chip->psy))
 		return dev_err_probe(dev, PTR_ERR(chip->psy),
 				     "failed to register power supply\n");
