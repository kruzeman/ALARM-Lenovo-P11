diff --git a/drivers/input/touchscreen/himax_hx83102e/himax_common.c b/drivers/input/touchscreen/himax_hx83102e/himax_common.c
index 8ec02f286..6afade7ca 100644
--- a/drivers/input/touchscreen/himax_hx83102e/himax_common.c
+++ b/drivers/input/touchscreen/himax_hx83102e/himax_common.c
@@ -1045,6 +1045,7 @@ int himax_input_register(struct himax_ts_data *ts)
 /*			0, 0);*/
 
 	if (himax_input_register_device(ts->input_dev) == 0) {
+		ts->input_registered = true;
 		ret = NO_ERR;
 	} else {
 		E("%s: input register fail\n", __func__);
@@ -1082,6 +1083,7 @@ int himax_input_register(struct himax_ts_data *ts)
 	input_abs_set_res(ts->hx_pen_dev, ABS_Y, 8);
 
 	if (himax_input_register_device(ts->hx_pen_dev) == 0) {
+		ts->pen_registered = true;
 		ret = NO_ERR;
 	} else {
 		E("%s: input register pen fail\n", __func__);
@@ -3297,7 +3299,13 @@ int himax_chip_common_init(void)
 err_get_intr_bit_failed:
 #endif
 err_input_register_device_failed:
-	input_free_device(ts->input_dev);
+	if (ts->input_dev) {
+		if (ts->input_registered)
+			input_unregister_device(ts->input_dev);
+		else
+			input_free_device(ts->input_dev);
+		ts->input_dev = NULL;
+	}
 /*err_detect_failed:*/
 
 #if defined(HX_CONTAINER_SPEED_UP)
@@ -3380,7 +3388,26 @@ void himax_chip_common_deinit(void)
 	}
 	destroy_workqueue(ts->himax_att_wq);
 #endif
-	input_free_device(ts->input_dev);
+	/*
+	 * Устройства зарегистрированы в input-ядре. input_free_device() на
+	 * зарегистрированном устройстве оставляет висячую запись в /sys/class/input:
+	 * имя указывает на освобождённую память, и чтение uevent такого устройства
+	 * роняет ядро (upowerd/udev первыми натыкаются). Нужен unregister.
+	 */
+	if (ts->input_dev) {
+		if (ts->input_registered)
+			input_unregister_device(ts->input_dev);
+		else
+			input_free_device(ts->input_dev);
+		ts->input_dev = NULL;
+	}
+	if (ts->hx_pen_dev) {
+		if (ts->pen_registered)
+			input_unregister_device(ts->hx_pen_dev);
+		else
+			input_free_device(ts->hx_pen_dev);
+		ts->hx_pen_dev = NULL;
+	}
 #if defined(HX_CONTAINER_SPEED_UP)
 	cancel_delayed_work_sync(&ts->ts_int_work);
 	destroy_workqueue(ts->ts_int_workqueue);
