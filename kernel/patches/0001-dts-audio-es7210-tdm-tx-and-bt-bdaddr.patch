diff --git a/arch/arm64/boot/dts/qcom/sm6115p-lenovo-j606f-audio.dtsi b/arch/arm64/boot/dts/qcom/sm6115p-lenovo-j606f-audio.dtsi
index be798d253..073537710 100644
--- a/arch/arm64/boot/dts/qcom/sm6115p-lenovo-j606f-audio.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6115p-lenovo-j606f-audio.dtsi
@@ -132,6 +132,22 @@ platform {
 				sound-dai = <&q6routing>;
 			};
 		};
+		builtin-mic-dai-link {
+			link-name = "Built-in Mic Capture";
+
+			codec {
+				sound-dai = <&es7210>;
+			};
+
+			cpu {
+				sound-dai = <&q6afedai PRIMARY_TDM_TX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6routing>;
+			};
+		};
+
 	};
 };
 
@@ -248,6 +264,20 @@ dai@18 {
 		qcom,tdm-data-delay = <0>;
 		qcom,tdm-data-align = <0>;
 	};
+
+	/* TX half of the same primary TDM bus: the ES7210 ADC drives data into
+	 * the SoC, the DSP keeps the bit/frame clock. Without this node the port
+	 * config is all zeroes and the ADSP rejects it (-22).
+	 */
+	dai@19 {
+		reg = <PRIMARY_TDM_TX_0>;
+		qcom,tdm-sync-mode = <0>;
+		qcom,tdm-sync-src = <1>;
+		qcom,tdm-data-out = <1>;
+		qcom,tdm-invert-sync = <1>;
+		qcom,tdm-data-delay = <0>;
+		qcom,tdm-data-align = <0>;
+	};
 };
 
 &swr0 {
@@ -259,6 +289,12 @@ wcd937x_tx: codec@0,3 {
 		compatible = "sdw20217010a00";
 		reg = <0 3>;
 		qcom,tx-port-mapping = <1 1 2 3>;
+		/* Статический маппинг каналов слейв->мастер для TX-портов кодека.
+		 * Без него драйвер берёт дефолты, порт настраивается неверно, и слейв
+		 * висит в состоянии Alert (захват потом не стартует и валит ADSP).
+		 * Порядок: adc1, adc2, adc3, mic0, dmic1, mbhc, dmic2..dmic7.
+		 */
+		qcom,tx-channel-mapping = /bits/ 8 <1 2 1 1 2 3 3 4 1 2 3 4>;
 	};
 };
 
@@ -271,6 +307,8 @@ wcd937x_rx: codec@0,4 {
 		compatible = "sdw20217010a00";
 		reg = <0 4>;
 		qcom,rx-port-mapping = <1 2 3 4 5>;
+		/* hph_l, hph_r, clsh, comp_l, comp_r, lo, dsd_r, dsd_l */
+		qcom,rx-channel-mapping = /bits/ 8 <1 2 1 1 2 1 1 2>;
 	};
 };
 
@@ -282,3 +320,14 @@ wcd_reset_n: wcd-reset-n-state {
 		output-high;
 	};
 };
+
+&i2c1 {
+	/* Built-in microphones: Everest ES7210 ADC, feeds the primary TDM TX port. */
+	es7210: audio-codec@40 {
+		compatible = "everest,es7210";
+		reg = <0x40>;
+		#sound-dai-cells = <0>;
+		vcc-supply = <&vph_pwr>;
+		status = "okay";
+	};
+};
