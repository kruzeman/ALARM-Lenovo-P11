 	struct regmap *regmap;
 };
 
+/*
+ * GENI-I2C на этом SoC изредка отдаёт -ETIMEDOUT на одиночном чтении
+ * (geni_i2c_gpi_xfer: I2C timeout). Без повтора power_supply-ядро решает,
+ * что батарея пропала, и в DE на пару секунд всплывает "разряжен/нет батареи".
+ * Повторяем чтение, прежде чем отдавать ошибку наверх.
+ */
+static int mm8013_read(struct mm8013_chip *chip, unsigned int reg, unsigned int *val)
+{
+	int ret = 0, i;
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_read(chip->regmap, reg, val);
+		if (!ret)
+			return 0;
+		usleep_range(2000, 4000);
+	}
+
+	return ret;
+}
+
