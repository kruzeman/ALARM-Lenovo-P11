diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index a2fc1316f..fa1e8980d 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -22,6 +22,7 @@
 #define TDM_BCLK_RATE		(48000 * TDM_SLOTS * TDM_SLOT_WIDTH)
 
 static const unsigned int tdm_slot_offset[] = { 0, 4 };
+static const unsigned int tdm_tx_slot_offset[] = { 0, 4, 8, 12 };
 
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
@@ -68,10 +69,20 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	struct snd_interval *channels = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_CHANNELS);
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+	struct snd_soc_dai *cpu_dai;
 
 	rate->min = rate->max = 48000;
-	channels->min = channels->max = 2;
-	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	/* Встроенные микрофоны по стоковому mixer_paths.xml идут как
+	 * PRI_TDM_TX_0 Channels=Four, Format=S32_LE, 48 кГц.
+	 */
+	cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	if (cpu_dai && (cpu_dai->id == PRIMARY_TDM_TX_0 || cpu_dai->id == PRIMARY_TDM_TX_1)) {
+		channels->min = channels->max = 4;
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S24_LE);
+	} else {
+		channels->min = channels->max = 2;
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	}
 
 	return 0;
 }
@@ -126,6 +137,29 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 					    ARRAY_SIZE(tdm_slot_offset),
 					    tdm_slot_offset);
 		break;
+	case PRIMARY_TDM_TX_0:
+		/* Встроенные микрофоны: ES7210 отдаёт данные в TX-половину того же
+		 * primary TDM, на котором работают динамики. Начинаем с формы кадра
+		 * рабочего RX — 2 канала, маска 0x3, слот 32 бита: ADSP отвергает
+		 * 4-канальный TX с ADSP_EBADPARAM (проверено на железе).
+		 */
+		/* У primary TDM один общий бит-клок для RX и TX: 3.072 МГц ADSP
+		 * отвергает (AFE set params failed -22), поэтому TX живёт в том же
+		 * кадре 4 x 32 = 128 бит, что и динамики.
+		 */
+		snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT,
+				       TDM_BCLK_RATE, SNDRV_PCM_STREAM_CAPTURE);
+		snd_soc_dai_set_tdm_slot(cpu_dai, GENMASK(3, 0), 0,
+					 TDM_SLOTS, TDM_SLOT_WIDTH);
+		snd_soc_dai_set_channel_map(cpu_dai, ARRAY_SIZE(tdm_tx_slot_offset),
+					    tdm_tx_slot_offset, 0, NULL);
+		/* Кодек тоже должен знать форму кадра: ES7210 настраивает SCLK/LRCK
+		 * по slots * slot_width (128), иначе захват отдаёт нули.
+		 */
+		if (codec_dai)
+			snd_soc_dai_set_tdm_slot(codec_dai, GENMASK(1, 0), 0,
+						 TDM_SLOTS, TDM_SLOT_WIDTH);
+		break;
 	default:
 		break;
 	}
