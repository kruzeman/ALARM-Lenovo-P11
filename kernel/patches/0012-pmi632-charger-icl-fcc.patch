 /* No interrupts yet: poll and notify userspace when plug or charge state change */
@@ -287,6 +362,25 @@ static void pmi632_poll(struct work_struct *work)
 	rt &= USBIN_PLUGIN_RT_STS;
 	stat &= CHGR_STATUS_MASK;
 
+	/* Открываем вход по типу источника: DCP/CDP — 3 А, SDP (порт ПК) —
+	 * 500 мА. Тип определяется не сразу после подключения, поэтому
+	 * следим за его изменением, а не только за фактом втыкания. */
+	if (rt) {
+		int type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+
+		if (!pmi632_get_usb_type(chip, &type) && type != chip->last_usb_type) {
+			chip->last_usb_type = type;
+			if (type == POWER_SUPPLY_USB_TYPE_DCP ||
+			    type == POWER_SUPPLY_USB_TYPE_CDP)
+				pmi632_set_step(chip, USBIN_ICL_CFG, 3000000);
+			else if (type == POWER_SUPPLY_USB_TYPE_SDP)
+				pmi632_set_step(chip, USBIN_ICL_CFG, 500000);
+			dev_info(chip->dev, "источник %d: ICL выставлен по типу\n", type);
+		}
+	} else {
+		chip->last_usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	}
+
 	if (rt != chip->last_online || stat != chip->last_state) {
 		chip->last_online = rt;
 		chip->last_state = stat;
