[Unit]
Description=Lenovo TB-J606F cover: SW_LID from gpio-keys -> suspend (with settle delay)
After=multi-user.target
# Без графической сессии смысла нет, а ранний suspend только тормозит загрузку.
ConditionPathExists=/dev/input/event2

[Service]
Type=simple
# Линия 36 занята gpio-keys (wakeup-source), поэтому читаем не gpiochip, а input-события.
# Демон ждёт 3 секунды после закрытия и только потом усыпляет: иначе gpio-keys будит
# систему тем же событием закрытия и получается цикл «уснул-проснулся».
ExecStart=/usr/bin/python3 /usr/local/bin/j606f-lid-daemon.py
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=graphical.target
