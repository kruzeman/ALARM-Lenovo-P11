+static int pmi632_set_step(struct pmi632_chg *chip, u16 reg, int ua)
+{
+	int step, ret;
+
+	if (ua < 0)
+		return -EINVAL;
+
+	step = ua / PMI632_CURRENT_STEP_UA;
+	if (step > 255)
+		step = 255;
+
+	ret = pmi632_write(chip, reg, step);
+	{
+		unsigned int a = 0, b = 0, p = 0, m = 0;
+		pmi632_read(chip, reg, &a);
+		pmi632_read(chip, DCDC_ICL_STATUS, &b);
+		pmi632_read(chip, DCDC_POWER_PATH_STATUS, &p);
+		pmi632_read(chip, DCDC_ICL_MAX_STATUS, &m);
+		{
+			unsigned int irt = 0, st1 = 0, st7 = 0;
+			pmi632_read(chip, USBIN_INT_RT_STS, &irt);
+			pmi632_read(chip, CHGR_STATUS_1, &st1);
+			pmi632_read(chip, CHGR_STATUS_7, &st7);
+			dev_info(chip->dev, "usbin_rt=%#x chgr1=%#x chgr7=%#x\n", irt, st1, st7);
+		}
+		dev_info(chip->dev,
+			 "set %#x: want %d uA -> step %d, readback %u, effective %u, path %#x%s, icl_max %u\n",
+			 reg, ua, step, a, b, p,
+			 (p & POWER_PATH_USBIN_SUSPEND) ? " (USBIN SUSPEND)" : "", m);
+	}
+	return ret;
+}
